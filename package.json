{
  "name": "agriflow-oracle-network",
  "version": "0.1.0",
  "private": true,
  "description": "Decentralized agricultural commodity and parametric weather oracle protocol on Stellar & Soroban",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "contracts:build": "cargo build --manifest-path contracts/Cargo.toml --target wasm32-unknown-unknown --release",
    "contracts:test": "cargo test --manifest-path contracts/Cargo.toml"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.4.5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@9.15.9"
}
