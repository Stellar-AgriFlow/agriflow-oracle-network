FROM node:20-alpine AS builder

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

COPY pnpm-lock.yaml package.json pnpm-workspace.yaml turbo.json tsconfig.json ./
COPY packages/types/package.json ./packages/types/
COPY packages/oracle-sdk/package.json ./packages/oracle-sdk/
COPY packages/node-cli/package.json ./packages/node-cli/
COPY apps/oracle-dashboard/package.json ./apps/oracle-dashboard/

RUN pnpm install --frozen-lockfile

COPY packages/ ./packages/
COPY apps/oracle-dashboard/ ./apps/oracle-dashboard/

RUN pnpm --filter @agriflow/types build && pnpm --filter oracle-dashboard build

FROM node:20-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000

COPY --from=builder /app /app

EXPOSE 3000

CMD ["pnpm", "--filter", "oracle-dashboard", "start"]
