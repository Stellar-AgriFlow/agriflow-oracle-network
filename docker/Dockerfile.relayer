FROM node:20-alpine AS builder

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

COPY pnpm-lock.yaml package.json pnpm-workspace.yaml ./
COPY packages/types/package.json ./packages/types/
COPY packages/oracle-sdk/package.json ./packages/oracle-sdk/
COPY packages/node-cli/package.json ./packages/node-cli/
COPY services/oracle-relayer/package.json ./services/oracle-relayer/

RUN pnpm install --frozen-lockfile

COPY packages/ ./packages/
COPY services/ ./services/

RUN pnpm --filter @agriflow/types build && pnpm --filter @agriflow/oracle-relayer build

FROM node:20-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production

COPY --from=builder /app /app

EXPOSE 9090

CMD ["node", "services/oracle-relayer/dist/index.js"]
